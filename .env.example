# ---------------------------------------------------------------------------
# Banco de dados: Redis da Vercel
# Crie o banco em Vercel → Storage → Redis e conecte ao projeto. A Vercel
# injeta REDIS_URL automaticamente. Para rodar local: `vercel env pull .env.local`.
# (Também funciona com Upstash pela Marketplace: KV_REST_API_URL + KV_REST_API_TOKEN.)
# Sem nenhuma dessas variáveis, o `npm run dev` guarda tudo em .data/kv.json.
# ---------------------------------------------------------------------------
REDIS_URL=

# Alternativa via REST (Upstash / Vercel KV)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ---------------------------------------------------------------------------
# Acesso ao painel (/admin)
# AUTH_SECRET: segredo para assinar o cookie de sessão. Gere um valor longo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ADMIN_LOGIN / ADMIN_PASSWORD: usados só no primeiro login, para criar o dono.
# Depois disso os acessos são gerenciados no painel, em Equipe.
# ---------------------------------------------------------------------------
AUTH_SECRET=
ADMIN_LOGIN=dono
ADMIN_PASSWORD=

# Endereço público do site (metadados, Open Graph e sitemap)
NEXT_PUBLIC_SITE_URL=https://batatasdaval.vercel.app
